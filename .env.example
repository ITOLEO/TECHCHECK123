# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Set your Supabase project URL and anon public key.
# Found in your Supabase project dashboard -> Settings -> API.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-publishable-key"

# PRIVILEGED SERVER-SIDE SECRET KEY (Supabase Secret Key or Service Role Key)
# Format: sb_secret_... or JWT service_role key.
# IMPORTANT: Configure ONLY on Vercel Server Environment Variables. NEVER expose to frontend.
SUPABASE_SECRET_KEY="sb_secret_your_server_privileged_secret_key"

# SUPERADMIN AUTHENTICATION PASSCODE
# Protects the /api/upload endpoint and superadmin management.
# Set a strong high-entropy alphanumeric secret in Vercel Production Environment Variables.
ADMIN_PASSCODE="your-strong-production-admin-passcode"

